# 1. Telegram: message @BotFather, send /newbot, paste the token here
TELEGRAM_BOT_TOKEN=
# Leave blank on first run — the bot will reply with your ID. Then paste it here and restart.
TELEGRAM_ALLOWED_USER_ID=

# 2. Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Triage (idea scoring), transcription, news/context research
GEMINI_MODEL=gemini-flash-latest
# Drafting + post scoring (a stronger model writes better long-form posts)
GEMINI_DRAFT_MODEL=gemini-pro-latest

# Ideas scoring at/above this get a "worth developing" recommendation
IDEA_THRESHOLD=6
# Reminders in your computer's local time, "day:hour" (0=Sun … 3=Wed, 5=Fri)
REMINDERS=3:18,5:9
NEWS_LOCALE=hl=en-IN&gl=IN&ceid=IN:en
